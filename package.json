{
  "name": "gustsim-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build -c vite.share.config.ts",
    "build:share": "vite build -c vite.share.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/schema.gen.ts",
    "gen:api:check": "openapi-typescript src/api/openapi.json -o src/api/.schema.check.ts && node -e \"const fs=require('fs');if(fs.readFileSync('src/api/.schema.check.ts','utf8')!==fs.readFileSync('src/api/schema.gen.ts','utf8')){console.error('schema.gen.ts is stale: run pnpm run gen:api');process.exit(1)}fs.unlinkSync('src/api/.schema.check.ts')\"",
    "check": "pnpm run gen:api:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@kitware/vtk.js": "^35.0.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "driver.js": "^1.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uplot": "^1.6.32",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
