FROM opencfd/openfoam-run:2606@sha256:4229997e74defb81548222d511b8e3b95b98305e5df41b8e88b031813fe47eeb
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip python3-vtk9 python3-numpy paraview python3-paraview xvfb xauth libgl1-mesa-dri && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY constraints.txt ./
COPY backend ./backend
COPY examples ./examples
RUN python3 -m venv --system-site-packages /opt/gustsim && /opt/gustsim/bin/pip install -c constraints.txt . && dpkg-query -W openfoam2606 paraview python3-vtk9 > /app/native-versions.txt
COPY docker/worker-entrypoint.sh /usr/local/bin/gustsim-entrypoint
COPY docker/pvbatch.sh /usr/local/bin/pvbatch
RUN chmod +x /usr/local/bin/gustsim-entrypoint /usr/local/bin/pvbatch && mkdir -p /data && chown 1000:1000 /data
ENV PATH="/opt/gustsim/bin:${PATH}" GUSTSIM_DATA=/data PYTHONUNBUFFERED=1 GUSTSIM_MEMORY_GB=20
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/gustsim-entrypoint"]
CMD ["python", "-m", "gustsim.worker"]
