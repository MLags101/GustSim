# Optional. docker compose up works without an .env file.
GUSTSIM_PORT=8080
GUSTSIM_API_MEMORY=6g
GUSTSIM_WORKER_MEMORY=22g
GUSTSIM_MEMORY_GB=20
# 0 = no cap; new simulations use the worker's physical cores minus the post lane.
GUSTSIM_CPUS=0
GUSTSIM_CAD_MEMORY=6g
# The post-processing lane shares the worker container with the solver.
GUSTSIM_POST_CPUS=1
GUSTSIM_POST_MEMORY_GB=4
